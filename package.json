{
  "name": "quicktools-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "npm run validate:tools && npm run validate:seo && next build",
    "start": "next start",
    "lint": "eslint",
    "validate:tools": "node scripts/validate-tool-registry.mjs",
    "validate:seo": "node scripts/validate-seo-coverage.mjs",
    "refresh:sitemap-fallback": "node scripts/refresh-sitemap-fallback.mjs",
    "check:links": "linkinator http://localhost:3001 --skip \"^(?!http://localhost:3001)\" --retry --markdown"
  },
  "dependencies": {
    "@cashfreepayments/cashfree-js": "^1.0.7",
    "@imgly/background-removal": "^1.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "github-slugger": "^2.0.0",
    "html2pdf.js": "^0.14.0",
    "jszip": "^3.10.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-auth": "^4.24.15",
    "pdf-lib": "^1.17.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "linkinator": "^8.0.3",
    "tailwindcss": "^4",
    "ts-morph": "^28.0.0",
    "typescript": "^5"
  }
}
